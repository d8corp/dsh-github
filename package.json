{
  "name": "dsh-github",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub CLI (gh) integration for DSH: configure a GitHub App and authenticate gh for git operations.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "Mikhail Lysikov <d8corp@mail.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d8corp/dsh-github.git"
  },
  "keywords": [
    "DeepSeek",
    "Harness",
    "GitHub",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/d8corp/dsh-github/issues"
  },
  "homepage": "https://github.com/d8corp/dsh-github",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": "1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.2.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "innetjs": "^3.2.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-util": "^29.5.0",
    "neostandard": "^0.13.0",
    "ts-jest": "^29.4.12",
    "ts-jest-mock-import-meta": "^1.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
