{
  "name": "@d8corp/dsh-github",
  "version": "0.0.3",
  "private": true,
  "description": "GitHub CLI (gh) integration for DSH: configure a GitHub App and authenticate gh for git operations.",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "author": "Mikhail Lysikov <d8corp@mail.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d8corp/dsh-github.git"
  },
  "keywords": [
    "DeepSeek",
    "Harness",
    "GitHub",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/d8corp/dsh-github/issues"
  },
  "homepage": "https://github.com/d8corp/dsh-github",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:theme && npm run build:client && innetjs release -tc -lc -e",
    "build:client": "innetjs build -i client -tc -lc -e",
    "build:theme": "innetjs run buildEnv.ts -e",
    "release": "npm run build:theme && npm run build:client && innetjs release -p -tc -lc -e",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dsh": {
    "manifestVersion": "1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.2.1",
    "@types/react": "18.3.31",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "innetjs": "^4.0.0-beta.10",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-util": "^29.5.0",
    "neostandard": "^0.13.0",
    "ts-jest": "^29.4.12",
    "ts-jest-mock-import-meta": "^1.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
