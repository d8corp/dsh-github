{
  "name": "dsh-github-app",
  "version": "0.0.1",
  "description": "GitHub CLI (gh) integration for DSH: configure a GitHub App and authenticate gh for git operations.",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "author": "Mikhail Lysikov <d8corp@mail.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d8corp/dsh-github-app.git"
  },
  "keywords": [
    "DeepSeek",
    "Harness",
    "GitHub",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/d8corp/dsh-github-app/issues"
  },
  "homepage": "https://github.com/d8corp/dsh-github-app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:theme && npm run build:client && innetjs release -tc -lc -e",
    "build:client": "innetjs build -i client -tc -lc -e",
    "build:theme": "innetjs run buildEnv.ts -e",
    "release": "npm run build:theme && npm run build:client && innetjs release -p -tc -lc -e",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dsh": {
    "manifestVersion": "1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}