INNETJS_ENV_PREFIX=DSH_PLUGIN_GITHUB_APP_
__ENV_EXTENDS=.env.theme
RELEASE_COPY_FILES={cordis.patch.yml,client/**/*,locale/**/*}
BUILD_FOLDER=client
RELEASE_TSCONFIG=tsconfig.release.json
BUILD_FORMAT=cjs
BUILD_BANNER="window.__ModuleLoader__.load({id:'dsh-github-app',factory(require){var module={exports:{}};var exports=module.exports;"
BUILD_FOOTER="return module.exports}});"
BUILD_EXTERNAL=react,react/jsx-runtime
